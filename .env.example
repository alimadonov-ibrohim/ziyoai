# Google AI Studio dan olingan kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server porti (ixtiyoriy)
PORT=3000

# Model kataloglash kesh vaqti, millisekund (ixtiyoriy)
MODELS_CACHE_MS=600000

# ============================================================
# KIRISH (AUTH) — email+parol doimo ishlaydi, qolganlari kalit kiritilganda
# ============================================================
# Saytning tashqi manzili (OAuth redirect uchun ishlatiladi). Mahalliy uchun:
PUBLIC_URL=http://localhost:3000

# Sessiya imzosi uchun ixtiyoriy sir. Bo'sh qolsa avtomatik yaratiladi (".auth-secret").
AUTH_SECRET=

# Foydalanuvchilarni doimiy saqlash (Vercel serverless uchun SHART).
# 1-variant: PostgreSQL (masalan Neon/Supabase). Postgres ustunligi bor.
# DATABASE_URL=postgresql://user:password@host:5432/ziyoai?sslmode=require
# 2-variant: Upstash Redis REST. Ikkalasi ham berilsa Postgres ishlatiladi.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
# Hech biri berilmasa: mahalliy data/users.json (Vercel'da /tmp — vaqtinchalik).

# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Telegram: @BotFather dan bot yaratib, token va username ni kiriting
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
